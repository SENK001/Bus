# Normalize text files to LF in the repository to avoid CRLF noise across platforms.
* text=auto eol=lf

# Gradle wrapper and shell scripts must keep LF line endings to stay executable.
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never normalize or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
