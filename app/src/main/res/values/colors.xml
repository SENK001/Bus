<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand + semantic color palette.

    Rules for this project:
    - UI should prefer Material3 theme attributes (?attr/colorOnSurface, ?attr/colorSurface, ...)
      so light/dark mode adapts automatically.
    - Only colors that must be resolved outside a themed view context keep concrete values here,
      with matching night values in values-night/colors.xml.
-->
<resources>
    <!-- Brand color. Also used as the adaptive launcher icon background. -->
    <color name="primary">#1565C0</color>

    <!--
        Semantic surfaces reserved for non-themed contexts (e.g. custom drawables/dialogs).
        Night values are provided in values-night/colors.xml.
    -->
    <color name="dialog_background">#FFFFFBFE</color>
</resources>
