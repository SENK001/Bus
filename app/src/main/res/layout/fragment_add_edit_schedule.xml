<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Title/icon tint come from the Material3 DayNight theme; do not hardcode black. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:menu="@menu/menu_add_edit"
        app:navigationContentDescription="@string/navigate_back"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.itheima.wheelpicker.WheelPicker
            android:id="@+id/wheel_hour"
            android:layout_width="120dp"
            android:layout_height="200dp"
            app:wheel_atmospheric="true"
            app:wheel_curved="true"
            app:wheel_cyclic="true"
            app:wheel_item_text_color="?attr/colorOnSurfaceVariant"
            app:wheel_item_text_size="36sp"
            app:wheel_selected_item_text_color="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="8dp"
            android:text="@string/time_separator"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.itheima.wheelpicker.WheelPicker
            android:id="@+id/wheel_minute"
            android:layout_width="120dp"
            android:layout_height="200dp"
            app:wheel_atmospheric="true"
            app:wheel_curved="true"
            app:wheel_cyclic="true"
            app:wheel_item_text_color="?attr/colorOnSurfaceVariant"
            app:wheel_item_text_size="36sp"
            app:wheel_selected_item_text_color="?attr/colorOnSurface" />

    </LinearLayout>

</LinearLayout>
