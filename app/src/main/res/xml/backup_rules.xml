<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 29/30 (android:fullBackupContent).
   API 31+ uses res/xml/data_extraction_rules.xml; keep both in sync.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Persistent route/schedule data (Room database, including its journal files). -->
    <include domain="database" path="bus_database"/>
    <include domain="database" path="bus_database-wal"/>
    <include domain="database" path="bus_database-shm"/>
</full-backup-content>
