<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep persistent route/schedule data in cloud backup. -->
        <include domain="database" path="bus_database"/>
        <include domain="database" path="bus_database-wal"/>
        <include domain="database" path="bus_database-shm"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bus_database"/>
        <include domain="database" path="bus_database-wal"/>
        <include domain="database" path="bus_database-shm"/>
    </device-transfer>
</data-extraction-rules>